# Copy to .env and adjust. Everything is optional - with no config at all
# Relay runs in-memory with the deterministic mock provider.

# Durable storage (docker compose sets this automatically)
# RELAY_DATABASE_URL=postgresql://relay:relay@localhost:5432/relay

# Real model calls
# RELAY_PROVIDER=anthropic
# RELAY_MODEL=claude-sonnet-4-5
# RELAY_ANTHROPIC_API_KEY=sk-ant-...
# RELAY_LLM_TIMEOUT_SECONDS=120
# RELAY_LLM_MAX_ATTEMPTS=3
# RELAY_LLM_RETRY_BACKOFF_SECONDS=0.25

# Tracing (e.g. Jaeger via `docker compose --profile tracing up`)
# RELAY_OTEL_ENDPOINT=http://localhost:4318/v1/traces
